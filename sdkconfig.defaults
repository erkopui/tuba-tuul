CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# Two firmware slots for the update over the air (main/ota.c). A new firmware
# that is not confirmed, or crashes before, is replaced by the previous one.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# WiFi and the TCP/IP stack on core 0, the application (app_main, HTTP server, Modbus) on core 1
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y
CONFIG_FMB_PORT_TASK_AFFINITY_CPU1=y

# The task watchdog is set up in app_main
CONFIG_ESP_TASK_WDT_INIT=n

# Optimize for size (-Os)
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Sockets: the web server takes up to 10 (7 clients and 3 of its own) and
# Modbus up to 6 (5 clients and the listening one). With the default of 10
# for everything, a browser that kept its 6 connections open locked out
# every other client, Modbus included.
CONFIG_LWIP_MAX_SOCKETS=20

# Modbus TCP only, the serial modes are not used
CONFIG_FMB_COMM_MODE_RTU_EN=n
CONFIG_FMB_COMM_MODE_ASCII_EN=n

# WireGuard adds an lwIP interface of its own and keeps its data in the
# interface's state pointer. esp_netif expects its own data there and crashes
# as soon as that interface gets its address. With bridge support enabled
# esp_netif keeps its pointer elsewhere. No bridge is used; this is the cheap
# option with that effect (0.4 KB, PPP support would be 22 KB).
CONFIG_ESP_NETIF_BRIDGE_EN=y
# Taking the tunnel away while connections are open through it needs about
# 2.1 KB of the TCP/IP task's stack, the default 3072 leaves too little spare.
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096

# Test: the 8 MB PSRAM of the ESP32-S3R8 (octal SPI, GPIO 33..37), with the
# code and the constants of the firmware copied into it at start and run from
# there instead of from flash. malloc() stays in the internal RAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
